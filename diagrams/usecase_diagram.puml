@startuml Antibody Sequence Loader - Use Case Diagram

left to right direction
skinparam packageStyle rectangle

actor Researcher as user
actor "Data Analyst" as analyst

rectangle "Antibody Sequence Loader System" {
  
  package "Data Loading" {
    usecase "Load CSV Dataset" as UC1
    usecase "Browse Files" as UC1.1
    usecase "Preview Metadata" as UC1.2
  }
  
  package "Network Analysis" {
    usecase "Analyze Dataset" as UC2
    usecase "Set Node Threshold" as UC2.1
    usecase "Set Edge Threshold" as UC2.2
    usecase "Normalize Network" as UC2.3
    usecase "Compute Edge Probabilities" as UC2.4
  }
  
  package "Visualization" {
    usecase "Generate Network Plot" as UC3
    usecase "View Interactive HTML" as UC3.1
    usecase "Export Plot" as UC3.2
  }
  
  package "Data Export" {
    usecase "Export Triplet Occurrences" as UC4
    usecase "Export Edge Data to CSV" as UC4.1
    usecase "Save Network Statistics" as UC4.2
  }
  
  package "Comparison" {
    usecase "Compare Two Datasets" as UC5
    usecase "Compare Regions (R1 vs R2)" as UC6
    usecase "Calculate Network Distance" as UC5.1
    usecase "Generate Comparison Report" as UC5.2
  }
  
  package "Multi-Dataset Management" {
    usecase "Add Another Dataset" as UC7
    usecase "Clear All Data" as UC8
  }
}

' User relationships
user --> UC1
user --> UC2
user --> UC3
user --> UC4
user --> UC5
user --> UC6
user --> UC7
user --> UC8

analyst --> UC4
analyst --> UC5

' Includes relationships
UC1 ..> UC1.1 : <<include>>
UC1 ..> UC1.2 : <<include>>

UC2 ..> UC2.1 : <<include>>
UC2 ..> UC2.2 : <<include>>
UC2 ..> UC2.3 : <<include>>
UC2 ..> UC2.4 : <<include>>

UC3 ..> UC3.1 : <<include>>
UC4 ..> UC4.1 : <<include>>

UC5 ..> UC5.1 : <<include>>
UC5 ..> UC5.2 : <<include>>
UC6 ..> UC5.1 : <<include>>
UC6 ..> UC5.2 : <<include>>

' Extends relationships
UC3.2 ..> UC3 : <<extend>>
UC4.2 ..> UC4 : <<extend>>

' Dependencies
UC2 ..> UC1 : <<requires>>
UC3 ..> UC2 : <<requires>>
UC4 ..> UC2 : <<requires>>
UC5 ..> UC2 : <<requires>>
UC6 ..> UC2 : <<requires>>

note right of UC2
  Analysis processes clones,
  creates k-mer networks,
  and applies thresholds
end note

note right of UC5
  Compares network structures
  between two different datasets
  using distance metrics
end note

note right of UC6
  Compares CDR regions (R1 vs R2)
  within the same dataset
end note

@enduml
